# API de lectura. Escucha solo en localhost; el frontend llega por un proxy inverso.
#   journalctl -u tsumi-api -f -o cat | jq 'select(.evento == "peticion")'
[Unit]
Description=tsumi: API de lectura
After=network-online.target postgresql.service

[Service]
User=aldo
WorkingDirectory=/home/aldo/tsumi_nasa_SA
# Rol de solo lectura (tsumi_lectura): la API está expuesta a internet y no debe poder escribir.
EnvironmentFile=/home/aldo/tsumi_nasa_SA/secretos/api.env
# El frontend se publica aparte (nasa.azzu.tech): CORS solo para ese origen.
Environment=ALLOWED_ORIGINS=https://nasa.azzu.tech
ExecStart=/home/aldo/tsumi_nasa_SA/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
